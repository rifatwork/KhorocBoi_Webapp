# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. All of these are server-side only — never prefix
# them with NEXT_PUBLIC_, or they would be shipped to every visitor's browser.

# Groq API key (starts with gsk_) for translating unknown Bangla/Banglish words.
# Get one at https://console.groq.com/keys. Leave empty to use the built-in dictionary only.
# On Vercel: Project → Settings → Environment Variables → GROQ_API_KEY, then redeploy.
GROQ_API_KEY=

# Upstash Redis. Cloud Sync stores each email's backup here. Create a new database
# at https://console.upstash.com and paste the REST URL and REST token (not the TCP URL).
# Required for backup. Also shares rate limits across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
