# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Your deployed khorocboi-server (no trailing slash).
SYNC_SERVER_URL=https://khorocboi-server.vercel.app

# Groq API key for translating unknown Bangla/Banglish words. Server-side only —
# never prefix with NEXT_PUBLIC_. Leave empty to use the built-in dictionary only.
GROQ_API_KEY=
