# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. All of these are server-side only — never prefix
# them with NEXT_PUBLIC_, or they would be shipped to every visitor's browser.

# Your deployed khorocboi-server (https, no trailing slash).
SYNC_SERVER_URL=https://khorocboi-server.vercel.app

# Groq API key (starts with gsk_) for translating unknown Bangla/Banglish words.
# Get one at https://console.groq.com/keys. Leave empty to use the built-in dictionary only.
GROQ_API_KEY=

# Optional: Upstash Redis so rate limits are shared across all Vercel instances.
# You can reuse the same database as khorocboi-server. Without these, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
